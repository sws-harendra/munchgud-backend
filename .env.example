# ==============================================================================
# MUNCHGUD BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your variables

NODE_ENV=development
PORT=8008

# ------------------------------------------------------------------------------
# DATABASE SETTINGS (MySQL)
# When running locally without Docker: host is 127.0.0.1 and port is 3306 or 3307
# When running inside Docker: host is mysql and port is 3306
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=munchgud_db
DB_USER=munchgud_user
DB_PASS=munchgud_password
DB_DIALECT=mysql

# ------------------------------------------------------------------------------
# REDIS CACHE
# When running locally: redis://localhost:6379
# When running inside Docker: redis://redis:6379
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# CORS & FRONTEND
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET=munchgud_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=munchgud_super_refresh_jwt_key_2026
JWT_SECRET_KEY=munchgud_seller_secret_jwt_key_2026
ACTIVATION_SECRET=munchgud_activation_secret_key_2026

# ------------------------------------------------------------------------------
# EMAIL SERVICE (Nodemailer / SMTP)
# ------------------------------------------------------------------------------
EMAILID=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM_NAME="MunchGud Store"
